 "components": {
  "schemas": {
   "AssistantRequest": {
    "properties": {
     "query": {
      "type": "string",
      "maxLength": 500,
      "minLength": 2,
      "title": "Query"
     },
     "live_context": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 700
       },
       {
        "type": "null"
       }
      ],
      "title": "Live Context"
     }
    },
    "type": "object",
    "required": [
     "query"
    ],
    "title": "AssistantRequest"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "RainfallScenario": {
    "properties": {
     "kind": {
      "type": "string",
      "enum": [
       "user_defined",
       "hyetograph"
      ],
      "title": "Kind",
      "default": "user_defined"
     },
     "value": {
      "anyOf": [
       {
        "type": "number",
        "maximum": 1000.0,
        "minimum": 0.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Value",
      "description": "total depth (mm); derived for a hyetograph"
     },
     "unit": {
      "type": "string",
      "const": "mm",
      "title": "Unit",
      "default": "mm"
     },
     "duration_hours": {
      "anyOf": [
       {
        "type": "number",
        "maximum": 168.0,
        "minimum": 0.25
       },
       {
        "type": "null"
       }
      ],
      "title": "Duration Hours"
     },
     "hyetograph_mm": {
      "anyOf": [
       {
        "items": {
         "type": "number"
        },
        "type": "array",
        "maxItems": 168,
        "minItems": 1
       },
       {
        "type": "null"
       }
      ],
      "title": "Hyetograph Mm",
      "description": "rain depth per step (mm), steps of step_hours"
     },
     "step_hours": {
      "type": "number",
      "maximum": 6.0,
      "minimum": 0.25,
      "title": "Step Hours",
      "default": 1.0
     }
    },
    "type": "object",
    "title": "RainfallScenario",
    "description": "Either a total depth + duration (kind=user_defined, triangular storm) or an hour-by-hour\nhyetograph (kind=hyetograph, e.g. a forecast or a replayed storm). For a hyetograph, value and\nduration_hours are derived from it and must not be sent."
   },
   "ScenarioRequest": {
    "properties": {
     "area_id": {
      "type": "string",
      "title": "Area Id",
      "default": "pilot_kakinada_01"
     },
     "name": {
      "type": "string",
      "maxLength": 120,
      "title": "Name",
      "default": ""
     },
     "rainfall_scenario": {
      "$ref": "#/components/schemas/RainfallScenario"
     },
     "drainage_blockage_fraction": {
      "type": "number",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Drainage Blockage Fraction",
      "default": 0.0
     },
     "overrides": {
      "additionalProperties": {
       "type": "string",
       "enum": [
        "blocked",
        "cleared"
       ]
      },
      "type": "object",
      "maxProperties": 200,
      "title": "Overrides"
     },
     "pumps": {
      "type": "boolean",
      "title": "Pumps",
      "default": false
     },
     "simulate": {
      "type": "boolean",
      "title": "Simulate",
      "description": "also run the reference flood solver (slow, <= 12 h)",
      "default": false
     }
    },
    "type": "object",
    "required": [
     "rainfall_scenario"
    ],
    "title": "ScenarioRequest"
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "type": "array",
      "title": "Location"
     },
     "msg": {
      "type": "string",
      "title": "Message"
     },
     "type": {
      "type": "string",
      "title": "Error Type"
     },
     "input": {
      "title": "Input"
     },
     "ctx": {
      "type": "object",
      "title": "Context"
     }
    },
    "type": "object",
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError"
   }
  }
 }
}