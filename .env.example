# frontend (optional - the 3D twin works without the API).
# Dev defaults to http://127.0.0.1:8000. A production build uses NO API unless you set this at build time
# to your deployed backend URL.
VITE_API_URL=http://127.0.0.1:8000
# VITE_BASE=/prithvi-ai/   # only when hosting under a sub-path (e.g. a GitHub Pages project site)

# backend
PRITHVI_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
PRITHVI_DATA_DIR=data/processed
